{
  "entities": {
    "TeacherGroup": {
      "title": "Teacher Group",
      "description": "Information about a training cohort, weekly dates, notes, and teacher participants with attendance.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the group"
        },
        "name": {
          "type": "string",
          "description": "Name of the group cohort"
        },
        "groupNumber": {
          "type": "number",
          "description": "Number of the group (e.g. 1 to 10)"
        },
        "day": {
          "type": "string",
          "description": "Day of the week for sessions"
        },
        "timeSlot": {
          "type": "string",
          "description": "Time slot for sessions"
        },
        "location": {
          "type": "string",
          "description": "Classroom or workshop location"
        },
        "totalWeeks": {
          "type": "number",
          "description": "Total count of training weeks"
        },
        "weekDates": {
          "type": "array",
          "description": "List of date labels for each week"
        },
        "notes": {
          "type": "string",
          "description": "General group notes"
        },
        "participants": {
          "type": "array",
          "description": "List of enrolled teachers with attendance records"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "name", "groupNumber", "day", "timeSlot", "location", "totalWeeks"]
    },
    "CurriculumWeek": {
      "title": "Curriculum Week",
      "description": "Weekly curriculum syllabus, learning outcomes, session flow, tools, practical exercises, and educator notes.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the curriculum week"
        },
        "weekNumber": {
          "type": "number",
          "description": "Week number (1-10)"
        },
        "title": {
          "type": "string",
          "description": "Title of the week"
        },
        "duration": {
          "type": "string",
          "description": "Duration label (e.g. 40 Dakika)"
        },
        "category": {
          "type": "string",
          "description": "Category of the session"
        },
        "summary": {
          "type": "string",
          "description": "Pedagogical summary of the session"
        },
        "learningOutcomes": {
          "type": "array",
          "description": "List of learning outcomes"
        },
        "sessionFlow": {
          "type": "array",
          "description": "Minute-by-minute session flow breakdown"
        },
        "keyTools": {
          "type": "array",
          "description": "AI tools covered in the session"
        },
        "practicalExercise": {
          "type": "string",
          "description": "Practical hands-on exercise description"
        },
        "samplePrompt": {
          "type": "string",
          "description": "Sample pedagogical prompt template"
        },
        "materials": {
          "type": "array",
          "description": "Downloadable or link resources"
        },
        "notes": {
          "type": "string",
          "description": "Educator and curriculum notes"
        },
        "customAdded": {
          "type": "boolean",
          "description": "Flag indicating if this week was created by an admin"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "weekNumber", "title"]
    },
    "LanguageModel": {
      "title": "Language Model",
      "description": "Details of an AI language model (e.g. GPT-4o, Gemini 2.0, Claude 3.7)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "developer": { "type": "string" },
        "contextWindow": { "type": "string" },
        "strengths": { "type": "array" },
        "educationFit": { "type": "string" },
        "freeTierStatus": { "type": "string" },
        "url": { "type": "string" },
        "bestFor": { "type": "string" },
        "badge": { "type": "string" }
      },
      "required": ["id", "name", "developer", "contextWindow", "url"]
    },
    "AITool": {
      "title": "AI Tool",
      "description": "Educational AI tools catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "educationUseCase": { "type": "string" },
        "pricing": { "type": "string" },
        "url": { "type": "string" },
        "featured": { "type": "boolean" },
        "tags": { "type": "array" }
      },
      "required": ["id", "name", "category", "description", "url"]
    },
    "AdditionalResource": {
      "title": "Additional Resource",
      "description": "Legal, ethical, or instructional resource or downloadable template",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "organization": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "linkText": { "type": "string" },
        "url": { "type": "string" },
        "fileType": { "type": "string" }
      },
      "required": ["id", "title", "organization", "category", "url"]
    },
    "PromptTemplate": {
      "title": "Prompt Template",
      "description": "Pedagogical prompt template for educators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "branch": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "goal": { "type": "string" },
        "promptText": { "type": "string" },
        "recommendedModel": { "type": "string" }
      },
      "required": ["id", "title", "promptText"]
    }
  },
  "firestore": {
    "/teacher_groups/{groupId}": {
      "schema": "TeacherGroup",
      "description": "Collection of teacher training groups, participants, and weekly attendance records"
    },
    "/curriculum_weeks/{weekId}": {
      "schema": "CurriculumWeek",
      "description": "Collection of weekly curriculum modules and course contents"
    },
    "/language_models/{modelId}": {
      "schema": "LanguageModel",
      "description": "Collection of language models and comparison data"
    },
    "/ai_tools/{toolId}": {
      "schema": "AITool",
      "description": "Collection of featured AI tools for educators"
    },
    "/additional_resources/{resourceId}": {
      "schema": "AdditionalResource",
      "description": "Collection of additional resources, official guidelines, and lesson plan templates"
    },
    "/prompt_templates/{promptId}": {
      "schema": "PromptTemplate",
      "description": "Collection of prompt templates and customizable prompts"
    }
  }
}
